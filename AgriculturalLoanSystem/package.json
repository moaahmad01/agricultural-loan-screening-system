{
  "name": "agriculturalloansystem-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Local frontend assets for the Agricultural Loan Screening System",
  "scripts": {
    "build:css": "node scripts/copy-vendor.mjs && tailwindcss -i ./wwwroot/css/tailwind-input.css -o ./wwwroot/css/tailwind-output.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/css/tailwind-input.css -o ./wwwroot/css/tailwind-output.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.19"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@fontsource/cairo": "^5.3.0",
    "sweetalert2": "11.26.25"
  }
}
