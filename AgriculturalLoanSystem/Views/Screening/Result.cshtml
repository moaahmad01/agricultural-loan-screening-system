@model AgriculturalLoanSystem.Models.ViewModels.EvaluationResultViewModel
@using AgriculturalLoanSystem.Data.Enums

@{
         var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "نتيجة الفحص" : "Screening Result";

    bool isEligible = Model.Recommendation == Recommendation.Eligible;
    bool isConditional = Model.Recommendation == Recommendation.EligibleWithConditions;

         string themeColor = isEligible ? "green" : (isConditional ? "amber" : "red");
    string iconClass = isEligible ? "fa-circle-check" : (isConditional ? "fa-triangle-exclamation" : "fa-circle-xmark");

    string title = "";
    string message = "";

         switch (Model.Recommendation)
    {
        case Recommendation.Eligible:
            title = isArabic ? "مؤهل للتمويل" : "Eligible for Funding";
            message = isArabic ? "المشروع يستوفي كافة المعايير المطلوبة." : "The project meets all the required criteria.";
            break;
        case Recommendation.EligibleWithConditions:
            title = isArabic ? "مؤهل بشروط" : "Conditional Eligibility";
            message = isArabic ? "المشروع مقبول ولكن يتطلب تحسينات أو ضمانات إضافية." : "Acceptable but requires additional improvements or guarantees.";
            break;
        case Recommendation.NotEligible:
            title = isArabic ? "غير مؤهل" : "Not Eligible";
            message = isArabic ? "للأسف، لا تنطبق شروط منح القرض على المعطيات الحالية." : "Unfortunately, the current data does not meet the loan requirements.";
            break;
    }
}

<div class="max-w-4xl mx-auto space-y-8 animate-fadeIn py-10" dir="@(isArabic ? "rtl" : "ltr")">

    <div class="bg-white rounded-[3rem] shadow-2xl overflow-hidden text-center relative border-4 border-@themeColor-100">
        <div class="bg-gradient-to-b from-@themeColor-50 to-white pt-16 pb-10 px-8 relative">

            <div class="w-32 h-32 mx-auto bg-white rounded-full flex items-center justify-center shadow-xl mb-6 relative z-10">
                <i class="fa-solid @iconClass text-6xl text-@themeColor-500"></i>
            </div>

            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-@themeColor-200 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob"></div>

            <h1 class="text-5xl font-black text-gray-800 mb-4 tracking-tight">@title</h1>
            <p class="text-xl text-gray-500 max-w-lg mx-auto font-medium">@message</p>
        </div>

        <div class="px-8 pb-12">
            <div class="relative w-full h-6 bg-gray-100 rounded-full overflow-hidden max-w-md mx-auto mb-4 shadow-inner">

                <div class="absolute top-0 left-0 h-full bg-gradient-to-r from-@themeColor-400 to-@themeColor-600 rounded-full transition-all duration-1000 ease-out"
                     style="width: @Model.Score%"></div>
            </div>
            <div class="flex justify-center items-baseline gap-2">
                <span class="text-6xl font-black text-@themeColor-600">@Model.Score.ToString("F1")</span>
                <span class="text-2xl font-bold text-gray-400">%</span>
            </div>
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-2">
                @(isArabic ? "مؤشر مطابقة المعايير" : "Criteria Compliance Score")
            </p>
        </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
            <div class="text-3xl font-black text-green-500 mb-1">@Model.YesCount</div>
            <div class="text-[10px] font-bold text-gray-400 uppercase">@(isArabic ? "إجابات نعم" : "Yes Answers")</div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
            <div class="text-3xl font-black text-red-500 mb-1">@Model.NoCount</div>
            <div class="text-[10px] font-bold text-gray-400 uppercase">@(isArabic ? "إجابات لا" : "No Answers")</div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm text-center">
            <div class="text-3xl font-black text-blue-500 mb-1">@Model.TotalQuestions</div>
            <div class="text-[10px] font-bold text-gray-400 uppercase">@(isArabic ? "إجمالي الأسئلة" : "Total Questions")</div>
        </div>
    </div>

    <div class="flex flex-col md:flex-row gap-4">
        <a asp-controller="Clients" asp-action="Details" asp-route-clientId="@Model.ClientId"
           class="flex-1 py-4 bg-gray-100 text-gray-600 rounded-2xl font-bold text-center hover:bg-gray-200 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid @(isArabic ? "fa-arrow-right" : "fa-arrow-left")"></i>
            @(isArabic ? "العودة لملف العميل" : "Back to Client Profile")
        </a>

        <a asp-action="SessionReport" asp-route-sessionId="@Model.SessionId" target="_blank"
           class="flex-1 py-4 bg-blue-50 text-blue-600 border border-blue-100 rounded-2xl font-bold text-center hover:bg-blue-100 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-print"></i> @(isArabic ? "طباعة التقرير" : "Print Report")
        </a>

        @if (Model.Recommendation != Recommendation.NotEligible)
        {
            <a asp-controller="Loans" asp-action="Calculate"
               asp-route-clientId="@Model.ClientId"
               asp-route-sessionId="@Model.SessionId"
               class="flex-[2] py-4 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-2xl font-black text-center shadow-xl shadow-green-100 hover:shadow-2xl hover:-translate-y-1 transition-all flex items-center justify-center gap-2">
                @(isArabic ? "الانتقال لحاسبة القروض" : "Go to Loan Calculator")
                <i class="fa-solid @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        }
    </div>
</div>