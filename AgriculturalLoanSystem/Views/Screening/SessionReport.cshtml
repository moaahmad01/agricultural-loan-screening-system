@model AgriculturalLoanSystem.Data.Entities.ScreeningSession
@using AgriculturalLoanSystem.Data.Enums

@{
    var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "تقرير جلسة فحص المناخ" : "Climate Screening Session Report";

         var answers = Model.Answers;

         var groupedAnswers = answers
        .Where(a => a.Question != null && a.Question.Section != null)
        .GroupBy(a => a.Question.Section!)
        .OrderBy(g => g.Key.DisplayOrder)
        .ToList();

         bool hasLoan = ViewBag.HasLoan ?? false;

         bool isEligible = Model.Recommendation == Recommendation.Eligible ||
                     Model.Recommendation == Recommendation.EligibleWithConditions;
}

@functions {
    string GetRecommendationText(Recommendation? rec, bool isArabic)
    {
        if (rec == null) return isArabic ? "غير متوفر" : "N/A";
        switch (rec)
        {
            case Recommendation.Eligible:
                return isArabic ? "مؤهل للتمويل" : "Eligible";
            case Recommendation.EligibleWithConditions:
                return isArabic ? "مؤهل بشروط" : "Eligible w/ Conditions";
            case Recommendation.NotEligible:
                return isArabic ? "غير مؤهل" : "Not Eligible";
            default:
                return rec.ToString() ?? string.Empty;
        }
    }
}

<div class="container py-8" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="max-w-4xl mx-auto space-y-6">


        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 flex justify-between items-center print:border-b-2 print:rounded-none">
            <div>
                <h1 class="text-2xl font-black text-gray-800">@(isArabic ? "تقرير تقييم مخاطر المناخ" : "Climate Risk Assessment Report")</h1>
            </div>
            <div class="text-left no-print">
                <button onclick="window.print()" class="px-5 py-2.5 bg-gray-900 hover:bg-black text-white rounded-xl font-bold transition-all flex items-center gap-2">
                    <i class="fa-solid fa-print"></i> @(isArabic ? "طباعة التقرير" : "Print Report")
                </button>
            </div>
        </div>


        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">@(isArabic ? "معلومات العميل" : "Client Information")</h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <p class="text-[10px] text-gray-400 font-bold uppercase">@(isArabic ? "الاسم الكامل (عربي)" : "Full Name (AR)")</p>
                    <p class="font-bold text-gray-800">@(Model.Client?.FullNameAr ?? "---")</p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-400 font-bold uppercase">@(isArabic ? "الاسم الكامل (EN)" : "Full Name (EN)")</p>
                    <p class="font-bold font-sans text-gray-800">@(Model.Client?.FullNameEn ?? "---")</p>
                </div>
                <div>
                    <p class="text-[10px] text-gray-400 font-bold uppercase">@(isArabic ? "الرقم الوطني" : "National ID")</p>
                    <p class="font-mono font-bold text-blue-700">@(Model.Client?.NationalId ?? "---")</p>
                </div>
            </div>

            <div class="mt-6 pt-4 border-t border-gray-50">
                <p class="text-[10px] text-gray-400 font-bold uppercase">@(isArabic ? "تاريخ تعبئة الجلسة" : "Session Submission Date")</p>
                <p class="font-bold text-gray-700">@(Model.CompletedAt?.ToString("yyyy-MM-dd / hh:mm tt") ?? "---")</p>
            </div>
        </div>


        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4 flex items-center gap-2">
                <i class="fa-solid fa-paperclip"></i> @(isArabic ? "المرفقات والوثائق الداعمة" : "Attached Documents")
            </h3>

            @if (Model.Documents != null && Model.Documents.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @foreach (var doc in Model.Documents)
                    {
                        <div class="flex items-center justify-between p-3 bg-gray-50 rounded-xl border border-gray-100 shadow-sm">
                            <div class="flex items-center gap-3 truncate">
                                <i class="fa-solid fa-file-pdf text-red-500 text-lg shrink-0"></i>
                                <p class="text-xs font-bold text-gray-700 truncate" title="@doc.FileName">@doc.FileName</p>
                            </div>
                            <a asp-controller="Documents" asp-action="Screening" asp-route-documentId="@doc.Id" target="_blank" class="w-8 h-8 flex items-center justify-center text-blue-600 hover:bg-blue-50 rounded-lg transition-all">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="py-4 text-center border-2 border-dashed border-gray-50 rounded-xl text-gray-400 text-sm">
                    @(isArabic ? "لا توجد ملفات مرفقة" : "No documents attached")
                </div>
            }
        </div>


        <div class="space-y-10">
            @if (!groupedAnswers.Any())
            {
                <div class="bg-white p-10 rounded-2xl border border-dashed text-center text-gray-400">
                    @(isArabic ? "لا توجد إجابات مسجلة لهذه الجلسة" : "No answers found for this session")
                </div>
            }

            @foreach (var group in groupedAnswers)
            {
                <div class="section-block">

                    <div class="flex items-center gap-4 mb-4">
                        <h2 class="text-xl font-black text-gray-800 border-r-4 border-blue-600 pr-4 ltr:border-r-0 ltr:border-l-4 ltr:pl-4">
                            @(isArabic? group.Key.SectionNameAr : group.Key.SectionNameEn)
                        </h2>
                        <div class="h-px flex-1 bg-gray-100"></div>
                    </div>

                    <div class="space-y-4">
                        @foreach (var answer in group.OrderBy(a => a.Question.DisplayOrder))
                        {
                            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden break-inside-avoid shadow-sm">
                                <div class="p-5 flex justify-between items-center gap-6">
                                    <div class="flex-1">
                                        <p class="text-[11px] font-bold text-blue-500 uppercase mb-1">
                                            @(isArabic ? "سؤال" : "Question") @answer.QuestionId
                                        </p>
                                        <p class="text-gray-800 font-bold text-lg leading-relaxed">
                                            @(isArabic? answer.Question.QuestionTextAr : answer.Question.QuestionTextEn)
                                        </p>
                                    </div>

                                    <div class="shrink-0">
                                        @if (answer.Answer.ToString() == "Yes")
                                        {
                                            <span class="inline-flex items-center gap-2 px-5 py-2 bg-blue-50 text-blue-700 rounded-xl font-black text-sm border-2 border-blue-400 shadow-sm">
                                                <i class="fa-solid fa-check"></i> @(isArabic ? "نعم" : "Yes")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-2 px-5 py-2 bg-gray-50 text-gray-600 rounded-xl font-black text-sm border-2 border-gray-400 shadow-sm">
                                                <i class="fa-solid fa-xmark"></i> @(isArabic ? "لا" : "No")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>


        <div class="bg-gray-900 text-white rounded-2xl p-8 mt-12 break-inside-avoid shadow-xl border border-gray-800">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-center md:text-right">
                    <h2 class="text-xl font-black mb-2">@(isArabic ? "التوصية النهائية والنتيجة" : "Final Recommendation & Result")</h2>
                    <p class="text-gray-400 text-sm">@(isArabic ? "تم إصدار هذه النتيجة بناءً على المعايير المناخية المعتمدة." : "Generated based on approved climate criteria.")</p>
                </div>
                @{
                    var rec = Model.Recommendation;
                    var finalBg = rec == Recommendation.Eligible ? "bg-green-600 border-green-400" :
                    rec == Recommendation.EligibleWithConditions ? "bg-amber-500 border-amber-300" : "bg-red-600 border-red-400";
                }
                <div class="@finalBg text-white text-2xl font-black px-10 py-4 rounded-2xl shadow-2xl border-4 border-white/20 uppercase tracking-widest text-center min-w-[200px]">
                    @GetRecommendationText(rec, isArabic)
                </div>
            </div>
        </div>


        <div class="flex gap-4 no-print pt-6">
            <a asp-controller="Clients" asp-action="Details" asp-route-clientId="@(Model.ClientId)" class="flex-1 bg-gray-100 text-gray-600 font-bold py-4 rounded-2xl text-center hover:bg-gray-200 transition-all border border-gray-200">
                <i class="fa-solid fa-arrow-left ml-2"></i> @(isArabic ? "العودة للملف" : "Back to Profile")
            </a>

            @if (isEligible)
            {
                if (hasLoan)
                {
                    <div class="flex-1 bg-gray-50 border border-gray-200 text-gray-400 font-bold py-4 rounded-2xl text-center cursor-not-allowed flex items-center justify-center gap-2">
                        <i class="fa-solid fa-check-circle text-green-500 text-xl"></i>
                        @(isArabic ? "تم إنشاء طلب قرض سابقاً" : "Loan Application Exists")
                    </div>
                }
                else
                {
                    <a asp-controller="Loans" asp-action="Calculate"
                       asp-route-clientId="@(Model.ClientId)"
                       asp-route-sessionId="@Model.Id"
                       class="flex-1 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-bold py-4 rounded-2xl text-center hover:shadow-lg transition-all flex items-center justify-center gap-2 transform hover:-translate-y-1">
                        @(isArabic ? "الانتقال لحاسبة القروض" : "Go to Loan Calculator") <i class="fa-solid fa-calculator"></i>
                    </a>
                }
            }
        </div>
    </div>
</div>

<style>
    @@page {
        margin: 15mm;
        size: A4;
    }

    @@media print {
        .no-print {
            display: none !important;
        }

        body {
            background: white !important;
            -webkit-print-color-adjust: exact;
        }

        .shadow-sm, .shadow-xl, .shadow-2xl {
            box-shadow: none !important;
        }

        .border, .border-2 {
            border: 1px solid #ddd !important;
        }

        .break-inside-avoid {
            page-break-inside: avoid;
        }

        .bg-gray-900 {
            background-color: #111827 !important;
            color: white !important;
        }

        .bg-green-600 {
            background-color: #16a34a !important;
        }

        .bg-amber-500 {
            background-color: #f59e0b !important;
        }

        .bg-red-600 {
            background-color: #dc2626 !important;
        }

        .bg-blue-50 {
            background-color: #eff6ff !important;
        }

        .bg-gray-50 {
            background-color: #f9fafb !important;
        }
    }
</style>