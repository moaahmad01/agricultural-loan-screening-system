@model AgriculturalLoanSystem.Models.ViewModels.LoginViewModel
@{
    var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "تسجيل الدخول" : "Login";
}

<div class="flex items-center justify-center min-h-[80vh] px-4" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-xl border border-blue-100">
        <div class="text-center mb-8">
            <div class="bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <i class="fa-solid fa-right-to-bracket text-2xl text-blue-600"></i>
            </div>
            <h2 class="text-2xl font-bold text-gray-800">@(isArabic ? "تسجيل الدخول" : "Sign In")</h2>
        </div>

        <form asp-action="Login" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs text-center list-none"></div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@(isArabic ? "الرقم الوطني" : "National ID")</label>
                <input asp-for="NationalId" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                <span asp-validation-for="NationalId" class="text-red-500 text-xs"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">@(isArabic ? "كلمة المرور" : "Password")</label>
                <input asp-for="Password" type="password" class="w-full px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none transition-all">
                <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center text-sm text-gray-600">
                    <input asp-for="RememberMe" type="checkbox" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 @(isArabic ? "ml-2" : "mr-2")">
                    @(isArabic ? "تذكرني" : "Remember Me")
                </label>
            </div>

            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-lg shadow-blue-200 transition-all transform active:scale-95">
                @(isArabic ? "دخول" : "Login")
            </button>
        </form>

        <div class="mt-6 text-center text-sm">
            <span class="text-gray-500">@(isArabic ? "ليس لديك حساب؟" : "Don't have an account?")</span>
            <a asp-action="Register" class="text-blue-600 font-bold hover:underline ml-1">@(isArabic ? "أنشئ حساباً" : "Create one")</a>
        </div>
    </div>
</div>