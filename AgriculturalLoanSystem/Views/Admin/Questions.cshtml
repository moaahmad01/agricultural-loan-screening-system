@model IEnumerable<AgriculturalLoanSystem.Data.Entities.Question>
@using System.Globalization

@{
         var isArabic = CultureInfo.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "بنك الأسئلة" : "Question Bank";
    var selectedSectionId = ViewBag.SelectedSectionId as int?;
}

<div class="p-6 md:p-10 bg-gray-50 min-h-screen" dir="@(isArabic ? "rtl" : "ltr")">


    <div class="bg-gradient-to-r from-sky-500 to-blue-600 text-white shadow-lg rounded-3xl mb-10 overflow-hidden relative">
        <div class="absolute top-0 right-0 p-8 opacity-20 text-9xl transform translate-x-10 -translate-y-10">
            <i class="fa-solid fa-clipboard-question"></i>
        </div>
        <div class="max-w-7xl mx-auto px-8 py-12 relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-6">
                <div class="bg-white/20 w-20 h-20 rounded-2xl flex items-center justify-center text-4xl shadow-inner backdrop-blur-sm border border-white/10">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div>
                    <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight">
                        @(isArabic ? "أسئلة أداة الفحص" : "Screening Tool Questions")
                    </h1>
                    <p class="text-sky-100 text-lg mt-2 font-medium opacity-90">
                        @(isArabic ? "إدارة بنك الأسئلة وتوزيعها على الأقسام" : "Manage question bank and section assignments")
                    </p>
                </div>
            </div>

            <a asp-action="CreateQuestion" class="bg-white text-sky-700 px-6 py-3 rounded-xl font-bold text-sm hover:bg-sky-50 transition-all shadow-md flex items-center gap-2 active:scale-95">
                <i class="fa-solid fa-plus"></i>
                @(isArabic ? "إضافة سؤال جديد" : "Add New Question")
            </a>
        </div>
    </div>


    <div class="max-w-7xl mx-auto mb-6">
        <div class="bg-white p-5 rounded-3xl shadow-sm border border-gray-100 flex flex-col md:flex-row items-center gap-4">
            <div class="flex items-center gap-3 text-gray-500 min-w-max">
                <i class="fa-solid fa-filter text-sky-500"></i>
                <span class="text-sm font-bold">@(isArabic ? "تصفية حسب القسم:" : "Filter by Section:")</span>
            </div>
            <form method="get" asp-action="Questions" class="flex-1 w-full flex items-center gap-4">
                <select name="sectionId" onchange="this.form.submit()"
                        class="block w-full md:w-72 py-2.5 px-4 text-sm rounded-xl border-gray-200 focus:border-sky-500 focus:ring-sky-500 bg-gray-50 font-medium cursor-pointer transition-all">
                    <option value="">@(isArabic ? "-- جميع الأقسام --" : "-- All Sections --")</option>
                    @if (ViewBag.Sections != null)
                    {
                        foreach (var sec in (SelectList)ViewBag.Sections)
                        {
                            <option value="@sec.Value" selected="@(sec.Value == selectedSectionId?.ToString())">@sec.Text</option>
                        }
                    }
                </select>
                @if (selectedSectionId != null)
                {
                    <a asp-action="Questions" class="text-xs text-sky-600 hover:text-sky-800 font-bold underline transition-colors">
                        @(isArabic ? "إلغاء التصفية" : "Clear Filter")
                    </a>
                }
            </form>
        </div>
    </div>


    <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-gray-500 uppercase bg-gray-50 border-b border-gray-100">
                    <tr>
                        <th class="px-6 py-5 text-center w-24">@(isArabic ? "الترتيب" : "Order")</th>
                        <th class="px-6 py-5 text-start">@(isArabic ? "نص السؤال" : "Question Text")</th>
                        <th class="px-6 py-5 text-center">@(isArabic ? "القسم" : "Section")</th>
                        <th class="px-6 py-5 text-center">@(isArabic ? "الأهمية" : "Importance")</th>
                        <th class="px-6 py-5 text-center">@(isArabic ? "الحالة" : "Status")</th>
                        <th class="px-6 py-5 text-center">@(isArabic ? "إجراءات" : "Actions")</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 bg-white">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-sky-50/40 transition-colors duration-200 group">


                            <td class="px-6 py-5 text-center align-middle">
                                <span class="bg-gray-100 text-gray-600 px-3 py-1 rounded-lg text-xs font-mono font-bold border border-gray-200">
                                    #@item.DisplayOrder
                                </span>
                            </td>


                            <td class="px-6 py-5 align-middle">
                                <div class="flex flex-col justify-center items-start">
                                    <span class="font-black text-gray-800 text-base leading-tight">
                                        @(isArabic? item.QuestionTextAr: item.QuestionTextEn)
                                    </span>
                                    <span class="text-xs text-gray-400 font-medium mt-1 font-sans italic" dir="@(isArabic ? "ltr" : "rtl")">
                                        @(isArabic? item.QuestionTextEn: item.QuestionTextAr)
                                    </span>
                                </div>
                            </td>


                            <td class="px-6 py-5 text-center align-middle">
                                <span class="inline-flex items-center px-3 py-1 rounded-lg text-[11px] font-bold bg-sky-50 text-sky-700 border border-sky-100">
                                    @(isArabic? item.Section?.SectionNameAr : item.Section?.SectionNameEn)
                                </span>
                            </td>


                            <td class="px-6 py-5 text-center align-middle">
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-black bg-amber-50 text-amber-600 border border-amber-100">
                                    <i class="fa-solid fa-star text-[8px]"></i> @item.PointValue
                                </span>
                            </td>


                            <td class="px-6 py-5 text-center align-middle">
                                @if (item.IsActive)
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-600 border border-emerald-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> @(isArabic ? "مفعل" : "Active")
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-red-50 text-red-600 border border-red-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> @(isArabic ? "معطل" : "Inactive")
                                    </span>
                                }
                            </td>


                            <td class="px-6 py-5 text-center align-middle">
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="EditQuestion" asp-route-id="@item.Id"
                                       class="text-sky-600 hover:text-white border border-sky-200 hover:bg-sky-600 font-medium rounded-lg text-xs p-2 transition-all duration-200 shadow-sm">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <form asp-action="DeleteQuestion" method="post" class="inline-block">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="button"
                                                onclick="openDeleteModal(this, '@(isArabic? item.QuestionTextAr: item.QuestionTextEn)')"
                                                class="text-red-500 hover:text-white border border-red-200 hover:bg-red-500 font-medium rounded-lg text-xs p-2 transition-all duration-200 shadow-sm">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


<div id="deleteModal" class="relative z-50 hidden" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-lg border-2 border-red-100">
                <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start @(isArabic ? "flex-row-reverse text-right" : "")">
                        <div class="mx-auto flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-12 sm:w-12">
                            <i class="fa-solid fa-triangle-exclamation text-red-600 text-xl animate-pulse"></i>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 @(isArabic ? "sm:mr-4 sm:ml-0 sm:text-right" : "sm:text-left")">
                            <h3 class="text-xl font-bold leading-6 text-gray-900">
                                @(isArabic ? "حذف السؤال؟" : "Delete Question?")
                            </h3>
                            <div class="mt-2 text-sm text-gray-500">
                                <p id="itemNameSpan" class="font-black text-gray-800 mt-1 block"></p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                    <button type="button" onclick="submitDeleteForm()" class="inline-flex w-full justify-center rounded-xl bg-red-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm hover:bg-red-700 sm:w-auto transition-all">
                        @(isArabic ? "نعم، احذف الآن" : "Yes, Delete")
                    </button>
                    <button type="button" onclick="closeDeleteModal()" class="mt-3 inline-flex w-full justify-center rounded-xl bg-white px-5 py-2.5 text-sm font-bold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
                        @(isArabic ? "إلغاء" : "Cancel")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteForm = null;
    function openDeleteModal(btn, itemName) {
        deleteForm = btn.closest('form');
        document.getElementById('itemNameSpan').textContent = itemName;
        document.getElementById('deleteModal').classList.remove('hidden');
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.add('hidden');
        deleteForm = null;
    }
    function submitDeleteForm() { if (deleteForm) deleteForm.submit(); }
</script>