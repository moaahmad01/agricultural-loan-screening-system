@model AgriculturalLoanSystem.Data.Entities.Question

@{
         var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "تعديل السؤال" : "Edit Question";
}


<div class="p-6 md:p-10 bg-gray-50 min-h-screen" dir="@(isArabic ? "rtl" : "ltr")">


    <div class="max-w-4xl mx-auto mb-8">
        <div class="bg-gradient-to-r from-slate-600 to-gray-700 text-white shadow-lg rounded-3xl p-8 relative overflow-hidden">

            <div class="absolute top-0 right-0 p-4 opacity-10 text-8xl transform translate-x-4 -translate-y-4">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>

            <div class="relative z-10 flex items-center gap-6">

                <div class="bg-white/20 w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-inner backdrop-blur-sm border border-white/10">
                    <i class="fa-solid fa-pen"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
                        @(isArabic ? "تعديل بيانات السؤال" : "Edit Question Details")
                    </h1>
                    <p class="text-slate-200 text-sm mt-1 font-medium opacity-90">
                        @(isArabic ? "تحديث نصوص السؤال، الأهمية، أو القسم المرتبط" : "Update question text, importance, or assigned section")
                    </p>
                </div>
            </div>
        </div>
    </div>


    <div class="max-w-4xl mx-auto">
        <form asp-action="EditQuestion" class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
            @Html.AntiForgeryToken()


            <input type="hidden" asp-for="Id" />

            <div class="p-8 space-y-8">


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-50 border border-red-200 text-red-600 rounded-xl p-4 text-sm font-bold flex items-start gap-3">
                        <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                        <div asp-validation-summary="All" class="list-none"></div>
                    </div>
                }


                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <label asp-for="QuestionTextAr" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "نص السؤال (عربي)" : "Arabic Question")
                        </label>
                        <textarea asp-for="QuestionTextAr" rows="3"
                                  class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-slate-500 focus:ring-slate-500 shadow-sm bg-gray-50/50"></textarea>
                        <span asp-validation-for="QuestionTextAr" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>


                    <div>
                        <label asp-for="QuestionTextEn" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "نص السؤال (إنجليزي)" : "English Question")
                        </label>
                        <textarea asp-for="QuestionTextEn" rows="3"
                                  class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-slate-500 focus:ring-slate-500 shadow-sm bg-gray-50/50"></textarea>
                        <span asp-validation-for="QuestionTextEn" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>
                </div>

                <hr class="border-gray-100" />


                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">


                    <div>
                        <label asp-for="SectionId" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "نقل إلى قسم آخر" : "Move to Section")
                        </label>
                        <select asp-for="SectionId" asp-items="ViewBag.SectionId"
                                class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-slate-500 shadow-sm bg-gray-50/50 cursor-pointer">
                        </select>
                        <span asp-validation-for="SectionId" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>


                    <div class="bg-amber-50 p-5 rounded-2xl border border-amber-100 relative">
                        <label asp-for="PointValue" class="block text-sm font-bold text-amber-800 mb-2">
                            <i class="fa-solid fa-star mr-1 ml-1"></i> @(isArabic ? "نقاط الأهمية (1-5)" : "Point Value (1-5)")
                        </label>
                        <input asp-for="PointValue" type="number" min="1" max="5"
                               class="block w-full py-3 px-4 text-sm rounded-xl border-amber-200 focus:border-amber-500 shadow-sm bg-white font-bold text-amber-700" />
                        <span asp-validation-for="PointValue" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>


                    <div>
                        <label asp-for="DisplayOrder" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "ترتيب العرض" : "Display Order")
                        </label>
                        <input asp-for="DisplayOrder" type="number"
                               class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-slate-500 shadow-sm bg-gray-50/50" />
                        <span asp-validation-for="DisplayOrder" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>
                </div>


                <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100 flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="bg-white p-3 rounded-xl shadow-sm text-slate-600 border border-slate-100">
                            <i class="fa-solid fa-eye"></i>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-700">@(isArabic ? "حالة السؤال" : "Visibility")</p>
                            <p class="text-[11px] text-gray-400">@(isArabic ? "تفعيل أو تعطيل ظهور السؤال" : "Enable or disable Question visibility")</p>
                        </div>
                    </div>

                    <label class="relative inline-flex items-center cursor-pointer">
                        <input asp-for="IsActive" type="checkbox" class="sr-only peer">
                        <div class="w-14 h-7 bg-gray-200 rounded-full peer peer-checked:bg-slate-600 peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all"></div>
                    </label>
                </div>
            </div>


            <div class="bg-gray-50 px-8 py-6 border-t border-gray-100 flex flex-col md:flex-row gap-3 md:justify-end">
                <a asp-action="Questions" asp-route-sectionId="@Model.SectionId"
                   class="w-full md:w-auto px-8 py-3 rounded-xl border border-gray-300 bg-white text-gray-700 font-bold text-sm text-center hover:bg-gray-50 transition-all">
                    @(isArabic ? "إلغاء" : "Cancel")
                </a>
                <button type="submit" class="w-full md:w-auto px-10 py-3 rounded-xl bg-slate-600 text-white font-bold text-sm shadow-md hover:bg-slate-700 transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-save"></i>
                    @(isArabic ? "تحديث السؤال" : "Update Question")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}