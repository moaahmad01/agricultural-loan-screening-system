@model Dictionary<string, int>
@{
    var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "لوحة التحكم" : "Dashboard";
}

<div class="p-6 md:p-10 bg-gray-50 min-h-screen" dir="@(isArabic ? "rtl" : "ltr")">


    <div class="bg-gradient-to-r from-sky-500 to-blue-600 text-white shadow-lg rounded-3xl mb-10 overflow-hidden relative">
        <div class="absolute top-0 right-0 p-8 opacity-10 text-9xl transform translate-x-12 -translate-y-12">
            <i class="fa-solid fa-gauge-high"></i>
        </div>
        <div class="max-w-7xl mx-auto px-8 py-10 relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <h1 class="text-3xl md:text-4xl font-black tracking-tight">
                    @(isArabic ? "نظرة عامة على النظام" : "System Control Center")
                </h1>
                <p class="text-sky-100 text-lg mt-2 font-medium opacity-90">
                    @(isArabic ? "مرحباً بك مجدداً، إليك ملخص حي لعمليات النظام" : "Welcome back! Here is a live summary")
                </p>
            </div>
            <div class="bg-white/10 px-6 py-3 rounded-2xl backdrop-blur-sm border border-white/20">
                <p class="text-[10px] uppercase font-bold text-sky-200">@(isArabic ? "تاريخ اليوم" : "Today's Date")</p>
                <p class="text-sm font-black text-white">@DateTime.Now.ToString("dd MMMM yyyy")</p>
            </div>
        </div>
    </div>


    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">


        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 group">
            <div>
                <div class="bg-orange-50 w-12 h-12 rounded-2xl flex items-center justify-center text-orange-500 mb-4 border border-orange-100">
                    <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
                </div>
                <p class="text-[11px] font-black uppercase text-gray-400 tracking-wider mb-1">@(isArabic ? "طلبات قروض معلقة" : "Pending Loans")</p>
                <h4 class="text-4xl font-black text-gray-800">@Model["PendingLoans"]</h4>
            </div>

            <a asp-action="PendingLoans" class="mt-6 flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-orange-50 text-orange-700 hover:bg-orange-500 hover:text-white transition-all font-bold text-xs group-last:mb-0">
                <span>@(isArabic ? "المراجعة والاعتماد" : "Review Now")</span>
                <i class="fa-solid @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        </div>


        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 group">
            <div>
                <div class="bg-sky-50 w-12 h-12 rounded-2xl flex items-center justify-center text-sky-600 mb-4 border border-sky-100">
                    <i class="fa-solid fa-user-gear text-xl"></i>
                </div>
                <p class="text-[11px] font-black uppercase text-gray-400 tracking-wider mb-1">@(isArabic ? "إجمالي المستخدمين" : "Total Users")</p>
                <h4 class="text-4xl font-black text-gray-800">@Model["TotalUsers"]</h4>
            </div>
            <a asp-action="ManageUsers" class="mt-6 flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-sky-50 text-sky-700 hover:bg-sky-600 hover:text-white transition-all font-bold text-xs">
                <span>@(isArabic ? "إدارة الصلاحيات" : "Manage Users")</span>
                <i class="fa-solid @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        </div>


        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 group">
            <div>
                <div class="bg-emerald-50 w-12 h-12 rounded-2xl flex items-center justify-center text-emerald-600 mb-4 border border-emerald-100">
                    <i class="fa-solid fa-list-check text-xl"></i>
                </div>
                <p class="text-[11px] font-black uppercase text-gray-400 tracking-wider mb-1">@(isArabic ? "بنك الأسئلة" : "Question Bank")</p>
                <h4 class="text-4xl font-black text-gray-800">@Model["TotalQuestions"]</h4>
            </div>
            <a asp-action="Questions" class="mt-6 flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-600 hover:text-white transition-all font-bold text-xs">
                <span>@(isArabic ? "إدارة المعايير" : "Manage Criteria")</span>
                <i class="fa-solid @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        </div>


        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 flex flex-col justify-between hover:shadow-xl transition-all duration-300 group">
            <div>
                <div class="bg-indigo-50 w-12 h-12 rounded-2xl flex items-center justify-center text-indigo-600 mb-4 border border-indigo-100">
                    <i class="fa-solid fa-chart-pie text-xl"></i>
                </div>
                <p class="text-[11px] font-black uppercase text-gray-400 tracking-wider mb-1">@(isArabic ? "أقسام التقييم" : "Active Sections")</p>
                <h4 class="text-4xl font-black text-gray-800">@Model["ActiveSections"]</h4>
            </div>
            <a asp-action="Sections" class="mt-6 flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white transition-all font-bold text-xs">
                <span>@(isArabic ? "توزيع الأوزان" : "Manage Weights")</span>
                <i class="fa-solid @(isArabic ? "fa-arrow-left" : "fa-arrow-right")"></i>
            </a>
        </div>
    </div>


    <div class="bg-slate-900 rounded-3xl p-10 text-white shadow-2xl relative overflow-hidden">
        <h3 class="text-2xl font-black mb-8 flex items-center gap-3">
            <i class="fa-solid fa-bolt-lightning text-yellow-400"></i>
            @(isArabic ? "اختصارات التحكم السريع" : "Quick Shortcuts")
        </h3>
        <div class="flex flex-wrap gap-5">
            <a asp-action="AuditLogs" class="bg-white/10 hover:bg-white hover:text-slate-900 px-8 py-4 rounded-2xl border border-white/20 transition-all flex items-center gap-3 font-bold text-sm">
                <i class="fa-solid fa-shield-halved"></i> @(isArabic ? "سجل الرقابة والأمان" : "Security Logs")
            </a>
            <a asp-action="CreateQuestion" class="bg-sky-500 hover:bg-sky-400 px-8 py-4 rounded-2xl transition-all flex items-center gap-3 font-bold text-sm shadow-xl">
                <i class="fa-solid fa-plus"></i> @(isArabic ? "إضافة معيار جديد" : "New Criteria")
            </a>
            <a asp-action="CreateSection" class="bg-indigo-600 hover:bg-indigo-500 px-8 py-4 rounded-2xl transition-all flex items-center gap-3 font-bold text-sm shadow-xl">
                <i class="fa-solid fa-folder-plus"></i> @(isArabic ? "إنشاء قسم جديد" : "New Section")
            </a>
        </div>
    </div>
</div>