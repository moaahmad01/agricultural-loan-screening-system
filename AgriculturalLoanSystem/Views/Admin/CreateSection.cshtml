@model AgriculturalLoanSystem.Data.Entities.Section

@{
         var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    ViewData["Title"] = isArabic ? "إضافة قسم جديد" : "Create New Section";

         int remainingWeight = ViewBag.RemainingWeight ?? 0;
    int currentTotal = ViewBag.CurrentTotalWeight ?? 0;
}


<div class="p-6 md:p-10 bg-gray-50 min-h-screen" dir="@(isArabic ? "rtl" : "ltr")">


    <div class="max-w-3xl mx-auto mb-8">
        <div class="bg-gradient-to-r from-sky-500 to-blue-600 text-white shadow-lg rounded-3xl p-8 relative overflow-hidden">

            <div class="absolute top-0 right-0 p-4 opacity-10 text-8xl transform translate-x-4 -translate-y-4">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div class="relative z-10 flex items-center gap-6">

                <div class="bg-white/20 w-16 h-16 rounded-2xl flex items-center justify-center text-3xl shadow-inner backdrop-blur-sm border border-white/10">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">
                        @(isArabic ? "إضافة قسم تقييم جديد" : "Create Assessment Section")
                    </h1>
                    <p class="text-sky-100 text-sm mt-1 font-medium opacity-90">
                        @(isArabic ? "إعداد قسم جديد لتصنيف الأسئلة وتوزيع أوزان المخاطر" : "Setup a new section for categorizing questions and risk weights")
                    </p>
                </div>
            </div>
        </div>
    </div>


    <div class="max-w-3xl mx-auto">
        <form asp-action="CreateSection" class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
            @Html.AntiForgeryToken()

            <div class="p-8 space-y-8">


                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="bg-red-50 border border-red-200 text-red-600 rounded-xl p-4 text-sm font-bold flex items-start gap-3">
                        <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                        <div asp-validation-summary="All" class="list-none"></div>
                    </div>
                }


                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <div>
                        <label asp-for="SectionNameAr" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "اسم القسم (عربي)" : "Arabic Name") <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="SectionNameAr" class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-sky-500 focus:ring-sky-500 shadow-sm bg-gray-50/50"
                               placeholder="@(isArabic ? "مثال: الموارد المائية" : "Ex: Water Resources")" />
                        <span asp-validation-for="SectionNameAr" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>


                    <div>
                        <label asp-for="SectionNameEn" class="block text-sm font-bold text-gray-700 mb-2">
                            @(isArabic ? "اسم القسم (إنجليزي)" : "English Name") <span class="text-red-500">*</span>
                        </label>
                        <input asp-for="SectionNameEn" class="block w-full py-3 px-4 text-sm rounded-xl border-gray-200 focus:border-sky-500 focus:ring-sky-500 shadow-sm bg-gray-50/50"
                               placeholder="Ex: Water Resources" />
                        <span asp-validation-for="SectionNameEn" class="text-xs text-red-500 font-bold mt-1 block"></span>
                    </div>
                </div>

                <hr class="border-gray-100" />


                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">


                    <div class="bg-sky-50 p-5 rounded-2xl border border-sky-100 relative">
                        <label asp-for="Weight" class="block text-sm font-bold text-sky-800 mb-2">
                            <i class="fa-solid fa-weight-scale mr-1 ml-1"></i> @(isArabic ? "الوزن النسبي (%)" : "Weight Percentage")
                        </label>



                        <input asp-for="Weight" type="number" min="0" max="@remainingWeight"
                               id="weightInput" data-max-weight="@remainingWeight"
                               class="block w-full py-3 px-4 text-sm rounded-xl border-sky-200 focus:border-sky-500 focus:ring-sky-500 shadow-sm bg-white font-bold text-sky-700 transition-all"
                               oninput="validateAndUpdateWeight(this)" />


                        <p id="weightWarning" class="text-[10px] text-red-500 mt-1 hidden font-bold">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            @(isArabic ? $"لا يمكنك تجاوز الوزن المتاح ({remainingWeight}%)" : $"Cannot exceed available weight ({remainingWeight}%)")
                        </p>

                        <div class="mt-5 pt-4 border-t border-sky-100">
                            <p class="text-[10px] text-gray-500 mb-2 flex justify-between">
                                <span>@(isArabic ? "تأثير الوزن على الإجمالي" : "Impact on Total Weight")</span>
                                <span class="font-bold text-gray-700">@currentTotal% + <span id="addedWeightText" class="text-sky-600">0</span>%</span>
                            </p>
                            <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden flex">

                                <div class="bg-gray-400 h-2" style="width: @currentTotal%"></div>

                                <div id="progressBarNew" class="bg-sky-500 h-2 transition-all duration-300" style="width: 0%"></div>
                            </div>
                            <p class="text-[9px] text-sky-600 mt-2 italic">
                                @(isArabic ? $"المساحة المتاحة المتبقية: {remainingWeight}%" : $"Available remaining: {remainingWeight}%")
                            </p>
                        </div>
                    </div>


                    <div class="space-y-6">

                        <div>
                            <label asp-for="DisplayOrder" class="block text-sm font-bold text-gray-700 mb-2">
                                @(isArabic ? "ترتيب العرض" : "Display Order")
                            </label>
                            <div class="relative">
                                <div class="absolute inset-y-0 @(isArabic ? "right-0 pr-3" : "left-0 pl-3") flex items-center pointer-events-none text-gray-400">
                                    <i class="fa-solid fa-arrow-down-1-9"></i>
                                </div>
                                <input asp-for="DisplayOrder" type="number" class="block w-full py-3 @(isArabic ? "pr-10" : "pl-10") text-sm rounded-xl border-gray-200 focus:border-sky-500 focus:ring-sky-500 shadow-sm bg-gray-50/50" />
                            </div>
                        </div>


                        <div class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-green-50 rounded-lg text-green-600">
                                    <i class="fa-solid fa-toggle-on text-lg"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-gray-700">@(isArabic ? "حالة القسم" : "Section Status")</p>
                                    <p class="text-[11px] text-gray-400">@(isArabic ? "تفعيل أو تعطيل ظهور القسم" : "Enable or disable section visibility")</p>
                                </div>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input asp-for="IsActive" type="checkbox" class="sr-only peer">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-sky-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-sky-600"></div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>


            <div class="bg-gray-50 px-8 py-5 border-t border-gray-100 flex flex-col md:flex-row gap-3 md:justify-end">
                <a asp-action="Sections" class="w-full md:w-auto px-6 py-3 rounded-xl border border-gray-300 bg-white text-gray-700 font-bold text-sm shadow-sm hover:bg-gray-50 text-center transition-all">
                    @(isArabic ? "إلغاء" : "Cancel")
                </a>
                <button type="submit" class="w-full md:w-auto px-8 py-3 rounded-xl bg-sky-600 text-white font-bold text-sm shadow-md hover:bg-sky-700 hover:shadow-lg transition-all flex items-center justify-center gap-2">
                    <i class="fa-solid fa-check"></i>
                    @(isArabic ? "حفظ القسم" : "Save Section")
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/section-weight-validator.js" asp-append-version="true"></script>
}