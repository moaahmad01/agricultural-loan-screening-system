<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the framework used by the MVC application. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- لاختبارات التكامل الخفيفة على AppDbContext بلا حاجة لخادم SQL Server فعلي -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <!-- لعمل Mock بسيط لـ IHttpContextAccessor وغيره عند الحاجة -->
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgriculturalLoanSystem\AgriculturalLoanSystem.csproj" />
  </ItemGroup>

</Project>